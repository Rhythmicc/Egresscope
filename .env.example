# Copy to .env, generate every secret independently, and never commit the result.
EGRESSCOPE_SESSION_SECRET=replace-with-at-least-32-random-characters
EGRESSCOPE_ADMIN_USERNAME=admin
EGRESSCOPE_ADMIN_PASSWORD=replace-with-a-long-random-password
EGRESSCOPE_SECURE_COOKIE=true
EGRESSCOPE_AUDIT_RETENTION_DAYS=14
EGRESSCOPE_INFRASTRUCTURE_SOURCE_IPS=127.0.0.1,::1,198.18.0.1,172.17.0.2,172.18.0.3
MIHOMO_CONTROLLER_SECRET=replace-with-the-controller-secret-from-config-yaml
